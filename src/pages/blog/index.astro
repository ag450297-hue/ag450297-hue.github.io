---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Container from '../../components/Container.astro';
import Glow from '../../components/Glow.astro';

// Estructura de las 5 carpetas de evidencias
const carpetasEvidencias = [
  {
    titulo: 'Presentación Personal',
    slug: 'presentacion',
    icono: '👤',
    descripcion: 'Video de presentación oficial (90-120s), perfil personal y motivaciones del curso.',
    estado: 'Obligatorio / Listo',
    destacado: true,
  },
  {
    titulo: 'Modelado de Datos',
    slug: 'modelado',
    icono: '📐',
    descripcion: 'Diagramas Entidad-Relación (MER/MER-E), entidades, atributos y cardinalidades.',
    estado: 'Próximamente',
    destacado: false,
  },
  {
    titulo: 'Normalización',
    slug: 'normalizacion',
    icono: '⚙️',
    descripcion: 'Aplicación de formas normales (1FN, 2FN, 3FN) y optimización de esquemas.',
    estado: 'Próximamente',
    destacado: false,
  },
  {
    titulo: 'Consultas SQL',
    slug: 'sql',
    icono: '💾',
    descripcion: 'Scripts DDL/DML, consultas con JOINs, subconsultas y funciones en Oracle/PostgreSQL.',
    estado: 'Próximamente',
    destacado: false,
  },
  {
    titulo: 'Proyecto Integrador',
    slug: 'proyecto',
    icono: '🚀',
    descripcion: 'Caso práctico final: diseño, implementación y documentación completa de la BD.',
    estado: 'Próximamente',
    destacado: false,
  },
];
---

<BaseLayout
  title="Evidencias — Bases de Datos 1"
  description="E-Portafolio académico oficial para la asignatura Bases de Datos 1 - Ingeniería de Sistemas."
>
  <section class="relative overflow-hidden">
    <Glow class="left-1/2 top-[-220px] h-[440px] w-[780px] -translate-x-1/2" />

    <Container class="relative pb-20 pt-16 sm:pb-28 sm:pt-24">
      <!-- Encabezado de la Sección -->
      <header class="max-w-3xl">
        <p class="font-mono text-[13px] uppercase tracking-widest text-accent">
          Asignatura: Bases de Datos 1
        </p>
        <h1 class="mt-3 text-balance text-4xl font-semibold tracking-tight sm:text-5xl">
          Módulos y <span class="text-gradient">Evidencias Académicas</span>
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-lg leading-relaxed text-fg-2">
          Repositorio digital para la organización, recopilación y entrega de talleres prácticos, 
          modelos relacionales y proyectos del semestre.
        </p>
      </header>

      <!-- Banner del Video Obligatorio (Presentación) -->
      <div class="mt-10 overflow-hidden rounded-xl border border-line bg-panel p-6 sm:p-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div class="space-y-2 max-w-2xl">
            <div class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-accent">
              <span class="inline-block h-2 w-2 rounded-full bg-accent shadow-[0_0_8px_rgb(34_211_238/0.8)]"></span>
              Requisito Principal
            </div>
            <h2 class="text-xl font-semibold text-fg sm:text-2xl">
              Video de Presentación Oficial (90 - 120s)
            </h2>
            <p class="text-sm text-fg-2 leading-relaxed">
              Video integrador donde expongo mi perfil, pasatiempos, el impacto de las Bases de Datos en mi carrera profesional y metas del semestre.
            </p>
          </div>
          <div class="flex shrink-0 items-center gap-3">
            <Button href="/blog/presentacion/" size="md">
              Ver Presentación y Video →
            </Button>
          </div>
        </div>
      </div>

      <!-- Grilla con las 5 Carpetas de Evidencias -->
      <div class="mt-12">
        <h2 class="font-mono text-xs uppercase tracking-widest text-fg-3 mb-6">
          Carpetas de Contenido
        </h2>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {carpetasEvidencias.map((carpeta) => (
            <article class="group relative flex flex-col justify-between overflow-hidden rounded-xl border border-line bg-panel p-6 transition-colors duration-200 hover:border-line-2 hover:bg-panel-2">
              <div>
                <div class="flex items-center justify-between">
                  <span class="text-3xl" role="img" aria-label={carpeta.titulo}>
                    {carpeta.icono}
                  </span>
                  <span class={`font-mono text-[11px] uppercase tracking-wider px-2.5 py-1 rounded-full border ${
                    carpeta.destacado 
                      ? 'border-accent/30 bg-accent/10 text-accent' 
                      : 'border-line bg-ink-2 text-fg-3'
                  }`}>
                    {carpeta.estado}
                  </span>
                </div>

                <h3 class="mt-4 text-xl font-semibold tracking-tight text-fg group-hover:text-accent transition-colors">
                  <a href={`/blog/${carpeta.slug}/`} class="focus:outline-none">
                    <span class="absolute inset-0" aria-hidden="true"></span>
                    {carpeta.titulo}
                  </a>
                </h3>

                <p class="mt-2 text-sm leading-relaxed text-fg-2">
                  {carpeta.descripcion}
                </p>
              </div>

              <div class="mt-6 flex items-center gap-1 text-xs font-medium text-fg-3 group-hover:text-fg transition-colors">
                <span>Explorar carpeta</span>
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>