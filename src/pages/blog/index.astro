---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
---

<BaseLayout
  title="Investigaciones — Angelica Gomez"
  description="Pequeños temas de investigación de Bases de Datos 1."
>
  <Container class="py-16 sm:py-24">
    <div class="mx-auto max-w-xl text-center">
      <h1 class="text-3xl font-semibold text-fg">Investigaciones</h1>
      <p class="mt-4 leading-relaxed text-fg-2">
        Mis temas de investigación están en su propia sección.
      </p>
      <a
        href="/evidencias/Investigaciones/"
        class="mt-6 inline-flex items-center rounded-lg bg-brand px-6 py-3 text-sm font-semibold text-white"
      >
        Ir a investigaciones →
      </a>
    </div>
  </Container>
</BaseLayout>