---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';

const recursos = [
  {
    numero: '01',
    categoria: 'Código fuente',
    titulo: 'Repositorio GitHub',
    descripcion: 'Consulta el código fuente, los archivos y la estructura del proyecto de Bases de Datos I.',
    detalle: 'ProyectoBasesDatosI',
    boton: 'Revisar código del proyecto',
    url: 'https://github.com/Ande2323/ProyectoBasesDatosI',
    icono: 'github',
    estilo: 'violeta',
  },
  {
    numero: '02',
    categoria: 'Modelo conceptual',
    titulo: 'Modelo Entidad-Relación Extendido',
    descripcion: 'Accede al documento del modelo entidad-relación extendido elaborado para el proyecto.',
    detalle: 'Documento compartido en Google Drive',
    boton: 'Consultar modelo E-R',
    url: 'https://drive.google.com/file/d/1GEW9fGDPhko-w6LuAv06Mhlj7vBKSKRA/view?usp=sharing',
    icono: 'database',
    estilo: 'azul',
  },
  {
    numero: '03',
    categoria: 'Documentación académica',
    titulo: 'Álgebra Relacional - Magic Cards',
    descripcion: 'Consulta el documento PDF con los ejercicios de álgebra relacional relacionados con el trabajo académico.',
    detalle: 'Algebra_Relacional_Magic_Cards.pdf',
    boton: 'Ver documento PDF',
    url: '/images/DOCUMENTOS/Algebra_Relacional_Magic_Cards.pdf',
    icono: 'file',
    estilo: 'violeta',
  },
];

const documentos = [
  {
    numero: '04',
    categoria: 'Diccionario de datos',
    titulo: 'Diccionario de Datos - Magic Cards',
    descripcion: 'Consulta el archivo comprimido que contiene el diccionario de datos del proyecto, con la descripción y organización de sus elementos.',
    detalle: 'Diccionario_Datos.zip',
    boton: 'Descargar ZIP',
    url: '/images/PROYECTO/Diccionario_Datos.zip',
    descarga: true,
    estilo: 'violeta',
  },
  {
    numero: '05',
    categoria: 'Propuesta académica',
    titulo: 'Propuesta del Proyecto BD1',
    descripcion: 'Consulta el documento PDF con la propuesta inicial del proyecto académico de Bases de Datos I.',
    detalle: 'Propuesta_Proyecto_BD1.pdf',
    boton: 'Ver documento PDF',
    url: '/images/PROYECTO/Propuesta_Proyecto_BD1.pdf',
    descarga: false,
    estilo: 'azul',
  },
  {
    numero: '06',
    categoria: 'Modelo relacional',
    titulo: 'Modelo Relacional - Magic Cards',
    descripcion: 'Consulta el documento PDF correspondiente al modelo relacional diseñado para la base de datos Magic Cards.',
    detalle: 'Relational_MAGIC_DB (1).pdf',
    boton: 'Ver modelo relacional',
    url: '/images/PROYECTO/Relational_MAGIC_DB%20(1).pdf',
    descarga: false,
    estilo: 'violeta',
  },
  {
    numero: '07',
    categoria: 'Documentación principal',
    titulo: 'Documento Principal - Magic Cards',
    descripcion: 'Consulta la documentación principal del proyecto, donde se presenta el desarrollo y la información general del sistema Magic Cards.',
    detalle: 'Magic_Cards_Documento_Principal.pdf',
    boton: 'Ver documento principal',
    url: '/images/PROYECTO/Magic_Cards_Documento_Principal.pdf',
    descarga: false,
    estilo: 'azul',
  },
];

const modeloRelacional = {
  numero: '08',
  categoria: 'Evidencias académicas',
  titulo: 'Modelo Relacional',
  descripcion: 'Accede a la sección de evidencias del modelo relacional, donde se presentan los ejercicios de reducción a tablas, transformaciones y modelos desarrollados durante el curso.',
  detalle: 'Sección de evidencias del portafolio',
  boton: 'Consultar evidencias del modelo relacional',
  url: '/evidencias',
};
---

<BaseLayout title="Proyecto - Bases de Datos I">
  <Container class="py-16 sm:py-24">

    <!-- ENCABEZADO -->
    <div class="mb-12 max-w-4xl">

      <div class="inline-flex items-center gap-2 rounded-full border border-violet-500/30 bg-violet-500/10 px-4 py-2 text-sm text-violet-300">
        <span class="h-2 w-2 rounded-full bg-violet-400"></span>
        Proyecto académico
      </div>

      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white sm:text-5xl">
        Proyecto de Bases de Datos I
      </h1>

      <p class="mt-4 text-lg leading-8 text-slate-400">
        En esta sección presento los recursos y documentos principales
        del proyecto académico de Bases de Datos I. Aquí se puede
        consultar el código fuente, revisar el modelo conceptual
        y acceder a la documentación complementaria.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <span class="rounded-full border border-violet-500/30 bg-violet-500/10 px-4 py-2 text-sm text-violet-300">
          Código fuente
        </span>

        <span class="rounded-full border border-blue-500/30 bg-blue-500/10 px-4 py-2 text-sm text-blue-300">
          Modelo E-R extendido
        </span>

        <span class="rounded-full border border-violet-500/30 bg-violet-500/10 px-4 py-2 text-sm text-violet-300">
          Documentación PDF
        </span>

        <span class="rounded-full border border-blue-500/30 bg-blue-500/10 px-4 py-2 text-sm text-blue-300">
          Modelo Relacional
        </span>
      </div>
    </div>

    <!-- RECURSOS DEL PROYECTO -->
    <div class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-400">
        Recursos del proyecto
      </p>

      <h2 class="mt-3 text-2xl font-semibold text-white sm:text-3xl">
        Código y modelo conceptual
      </h2>

      <p class="mt-3 text-sm leading-7 text-slate-400">
        Accede al repositorio y al modelo conceptual del proyecto.
      </p>
    </div>

    <div class="grid gap-8">

      {recursos.map((recurso) => (
        <article
          class:list={[
            'group relative flex flex-col overflow-hidden rounded-2xl border bg-slate-950 shadow-xl transition-all duration-300 hover:-translate-y-1 sm:flex-row',
            recurso.estilo === 'azul'
              ? 'border-blue-500/30 hover:border-blue-500/70'
              : 'border-violet-500/30 hover:border-violet-500/70',
          ]}
        >

          <!-- NÚMERO DEL RECURSO -->
          <div class:list={[
            'flex min-h-44 items-center justify-center p-8 sm:w-48 sm:shrink-0',
            recurso.estilo === 'azul'
              ? 'bg-gradient-to-br from-blue-950 via-slate-950 to-slate-900'
              : 'bg-gradient-to-br from-violet-950 via-slate-950 to-slate-900',
          ]}>
            <div class:list={[
              'flex h-24 w-24 items-center justify-center rounded-2xl border text-4xl font-bold transition-transform duration-300 group-hover:scale-105',
              recurso.estilo === 'azul'
                ? 'border-blue-400/30 bg-blue-500/10 text-blue-300'
                : 'border-violet-400/30 bg-violet-500/10 text-violet-300',
            ]}>
              {recurso.numero}
            </div>
          </div>

          <!-- INFORMACIÓN -->
          <div class="flex flex-1 flex-col justify-center p-6 sm:p-8">

            <div class="flex flex-wrap items-center gap-3">
              <span class:list={[
                'rounded-full border px-3 py-1 text-xs font-medium',
                recurso.estilo === 'azul'
                  ? 'border-blue-500/30 bg-blue-500/10 text-blue-300'
                  : 'border-violet-500/30 bg-violet-500/10 text-violet-300',
              ]}>
                {recurso.categoria}
              </span>

              <span class="text-xs text-slate-500">
                Recurso académico
              </span>
            </div>

            <h3 class="mt-4 text-xl font-semibold text-white sm:text-2xl">
              {recurso.titulo}
            </h3>

            <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-400">
              {recurso.descripcion}
            </p>

            <div class="mt-5 flex items-center gap-2 text-xs text-slate-500">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <path d="M14 2v6h6"/>
                <path d="M8 13h8M8 17h8"/>
              </svg>

              <span>{recurso.detalle}</span>
            </div>

            <!-- BOTÓN -->
            <div class="mt-6">
              <a
                href={recurso.url}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3 text-sm font-medium text-white transition-all duration-300',
                  recurso.estilo === 'azul'
                    ? 'bg-blue-600 hover:bg-blue-500'
                    : 'bg-violet-600 hover:bg-violet-500',
                ]}
              >
                {recurso.boton}

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M7 17 17 7"/>
                  <path d="M7 7h10v10"/>
                </svg>
              </a>
            </div>

          </div>
        </article>
      ))}

    </div>

    <!-- DOCUMENTACIÓN DEL PROYECTO -->
    <div class="mb-8 mt-16">
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-400">
        Documentación académica
      </p>

      <h2 class="mt-3 text-2xl font-semibold text-white sm:text-3xl">
        Documentos del proyecto Magic Cards
      </h2>

      <p class="mt-3 text-sm leading-7 text-slate-400">
        Consulta y descarga los documentos que respaldan el diseño,
        la estructura y el desarrollo de la base de datos.
      </p>
    </div>

    <div class="grid gap-8">

      {documentos.map((documento) => (
        <article
          class:list={[
            'group relative flex flex-col overflow-hidden rounded-2xl border bg-slate-950 shadow-xl transition-all duration-300 hover:-translate-y-1 sm:flex-row',
            documento.estilo === 'azul'
              ? 'border-blue-500/30 hover:border-blue-500/70'
              : 'border-violet-500/30 hover:border-violet-500/70',
          ]}
        >

          <!-- NÚMERO DEL DOCUMENTO -->
          <div class:list={[
            'flex min-h-44 items-center justify-center p-8 sm:w-48 sm:shrink-0',
            documento.estilo === 'azul'
              ? 'bg-gradient-to-br from-blue-950 via-slate-950 to-slate-900'
              : 'bg-gradient-to-br from-violet-950 via-slate-950 to-slate-900',
          ]}>
            <div class:list={[
              'flex h-24 w-24 items-center justify-center rounded-2xl border text-4xl font-bold transition-transform duration-300 group-hover:scale-105',
              documento.estilo === 'azul'
                ? 'border-blue-400/30 bg-blue-500/10 text-blue-300'
                : 'border-violet-400/30 bg-violet-500/10 text-violet-300',
            ]}>
              {documento.numero}
            </div>
          </div>

          <!-- INFORMACIÓN -->
          <div class="flex flex-1 flex-col justify-center p-6 sm:p-8">

            <div class="flex flex-wrap items-center gap-3">
              <span class:list={[
                'rounded-full border px-3 py-1 text-xs font-medium',
                documento.estilo === 'azul'
                  ? 'border-blue-500/30 bg-blue-500/10 text-blue-300'
                  : 'border-violet-500/30 bg-violet-500/10 text-violet-300',
              ]}>
                {documento.categoria}
              </span>

              <span class="text-xs text-slate-500">
                Documento académico
              </span>
            </div>

            <h3 class="mt-4 text-xl font-semibold text-white sm:text-2xl">
              {documento.titulo}
            </h3>

            <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-400">
              {documento.descripcion}
            </p>

            <div class="mt-5 flex items-center gap-2 text-xs text-slate-500">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <path d="M14 2v6h6"/>
                <path d="M8 13h8M8 17h8"/>
              </svg>

              <span>{documento.detalle}</span>
            </div>

            <!-- BOTÓN PDF O ZIP -->
            <div class="mt-6">
              <a
                href={documento.url}
                download={documento.descarga ? documento.detalle : undefined}
                target={documento.descarga ? undefined : '_blank'}
                rel={documento.descarga ? undefined : 'noopener noreferrer'}
                class:list={[
                  'inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3 text-sm font-medium text-white transition-all duration-300',
                  documento.estilo === 'azul'
                    ? 'bg-blue-600 hover:bg-blue-500'
                    : 'bg-violet-600 hover:bg-violet-500',
                ]}
              >
                {documento.boton}

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {documento.descarga ? (
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
                  ) : (
                    <>
                      <path d="M7 17 17 7"/>
                      <path d="M7 7h10v10"/>
                    </>
                  )}
                </svg>
              </a>
            </div>

          </div>
        </article>
      ))}

    </div>

    <!-- SECCIÓN MODELO RELACIONAL -->
    <div class="mb-8 mt-16">
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-400">
        Modelado de bases de datos
      </p>

      <h2 class="mt-3 text-2xl font-semibold text-white sm:text-3xl">
        Modelo Relacional
      </h2>

    <article class="group relative flex flex-col overflow-hidden rounded-2xl border border-violet-500/30 bg-slate-950 shadow-xl transition-all duration-300 hover:-translate-y-1 hover:border-violet-500/70 sm:flex-row">

      <!-- NÚMERO -->
      <div class="flex min-h-44 items-center justify-center bg-gradient-to-br from-violet-950 via-slate-950 to-slate-900 p-8 sm:w-48 sm:shrink-0">
        <div class="flex h-24 w-24 items-center justify-center rounded-2xl border border-violet-400/30 bg-violet-500/10 text-4xl font-bold text-violet-300 transition-transform duration-300 group-hover:scale-105">
          {modeloRelacional.numero}
        </div>
      </div>

      <!-- INFORMACIÓN -->
      <div class="flex flex-1 flex-col justify-center p-6 sm:p-8">

        <div class="flex flex-wrap items-center gap-3">
          <span class="rounded-full border border-violet-500/30 bg-violet-500/10 px-3 py-1 text-xs font-medium text-violet-300">
            {modeloRelacional.categoria}
          </span>

          <span class="text-xs text-slate-500">
            Evidencias académicas
          </span>
        </div>

        <h3 class="mt-4 text-xl font-semibold text-white sm:text-2xl">
          {modeloRelacional.titulo}
        </h3>

        <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-400">
          {modeloRelacional.descripcion}
        </p>

        <div class="mt-5 flex items-center gap-2 text-xs text-slate-500">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <ellipse cx="12" cy="5" rx="9" ry="3"/>
            <path d="M3 5v14a9 3 0 0 0 18 0V5"/>
            <path d="M3 12a9 3 0 0 0 18 0"/>
          </svg>

          <span>{modeloRelacional.detalle}</span>
        </div>

        <!-- BOTÓN -->
        <div class="mt-6">
          <a
            href={modeloRelacional.url}
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-violet-600 px-6 py-3 text-sm font-medium text-white transition-all duration-300 hover:bg-violet-500"
          >
            {modeloRelacional.boton}

            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7"/>
              <path d="M7 7h10v10"/>
            </svg>
          </a>
        </div>

      </div>
    </article>

    <!-- CIERRE -->
    <div class="mt-12 rounded-2xl border border-violet-500/20 bg-violet-500/5 p-6 sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-violet-400">
        Evidencias académicas
      </p>

      <h2 class="mt-3 text-xl font-semibold text-white">
        Desarrollo y documentación
      </h2>

      <p class="mt-3 text-sm leading-7 text-slate-400">
        Estos recursos permiten revisar el desarrollo del proyecto,
        consultar los documentos utilizados y acceder a las evidencias
        del proceso de diseño y construcción de la base de datos Magic Cards.
      </p>
    </div>

  </Container>
</BaseLayout>