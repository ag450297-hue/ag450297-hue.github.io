---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';

const categorias = [
  {
    href: '/evidencias/modeloEntidad/',
    titulo: 'MODELO ENTIDAD RELACIÓN (MER)',
    descripcion:
      'Diagramas conceptuales de talleres y quiz: entidades, relaciones, entidades débiles, ternarias, especialización y agregación.',
  },
  {
    href: '/evidencias/modeloRelacional/',
    titulo: 'MODELO RELACIONAL (MR)',
    descripcion:
      'Reducción del modelo entidad-relación a tablas, con llaves primarias y foráneas, incluyendo el parcial de CineAndes.',
  },
  {
    href: '/evidencias/normalizacion/',
    titulo: 'NORMALIZACIÓN',
    descripcion:
      'Ejercicios de normalización y diseño de bases de datos, desde la identificación de dependencias hasta la tercera forma normal.',
  },
  {
    href: '/evidencias/algebraRelacional/',
    titulo: 'ÁLGEBRA RELACIONAL',
    descripcion:
      'Consultas expresadas con operadores del álgebra relacional: selección, proyección, unión, producto y join.',
  },
  {
    href: '/evidencias/sql/',
    titulo: 'SQL',
    descripcion:
      'Consultas, ejercicios y actividades desarrolladas utilizando SQL.',
  },
  {
    href: '/evidencias/proyecto/',
    titulo: 'PROYECTO',
    descripcion:
      'Proyecto final y evidencias relacionadas con el desarrollo de la asignatura.',
  },
  {
    href: '/evidencias/Investigaciones/',
    titulo: 'INVESTIGACIONES',
    descripcion:
      'Pequeños temas de investigación sobre los contenidos vistos en clase, con ejemplos y fuentes.',
    cta: 'Leer investigaciones →',
  },
];
---

<BaseLayout
  title="Evidencias — ANGELICA GOMEZ"
  description="Evidencias académicas de Bases de Datos 1."
>

  <Container class="py-16 sm:py-24">

    <header class="text-center">

      <p class="font-mono text-sm uppercase tracking-widest text-fg-3">
        Bases de Datos 1
      </p>

      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-fg sm:text-5xl">
        Evidencias
      </h1>

      <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-fg-2">
        En esta sección se encuentran organizadas las evidencias
        desarrolladas durante el semestre, además de pequeños temas
        de investigación sobre los contenidos vistos en clase.
      </p>

    </header>

    <section class="mx-auto mt-12 grid max-w-5xl gap-6 sm:grid-cols-2">

      {categorias.map((c) => (
        <a
          href={c.href}
          class="rounded-2xl border border-line bg-panel p-7 transition-colors hover:bg-panel-2"
        >
          <h2 class="text-xl font-semibold text-fg">{c.titulo}</h2>

          <p class="mt-3 text-sm leading-relaxed text-fg-2">
            {c.descripcion}
          </p>

          <p class="mt-5 text-sm font-medium text-fg">
            {c.cta ?? 'Ver evidencias →'}
          </p>
        </a>
      ))}

    </section>

  </Container>

</BaseLayout>