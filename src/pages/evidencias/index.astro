```astro
---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
---

<BaseLayout
  title="Evidencias — [TU NOMBRE]"
  description="Evidencias académicas de Bases de Datos 1."
>

  <Container class="py-16 sm:py-24">

    <header class="text-center">

      <p class="font-mono text-[13px] uppercase tracking-widest text-fg-3">
        Bases de Datos 1
      </p>

      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-fg sm:text-5xl">
        Evidencias
      </h1>

      <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-fg-2">
        En esta sección se encuentran organizadas las evidencias
        desarrolladas durante el semestre.
      </p>

    </header>


    <section class="mx-auto mt-12 grid max-w-5xl gap-6 sm:grid-cols-2">

      <!-- MODELADO -->
      <a
        href="/evidencias/modelado/"
        class="rounded-2xl border border-line bg-panel p-7 transition-colors hover:bg-panel-2"
      >
        <h2 class="text-xl font-semibold text-fg">
          Modelado
        </h2>

        <p class="mt-3 text-sm leading-relaxed text-fg-2">
          Evidencias relacionadas con el modelado de bases de datos,
          modelo entidad-relación y modelo relacional.
        </p>

        <p class="mt-5 text-sm font-medium text-fg">
          Ver evidencias →
        </p>
      </a>


      <!-- NORMALIZACIÓN -->
      <a
        href="/evidencias/normalizacion/"
        class="rounded-2xl border border-line bg-panel p-7 transition-colors hover:bg-panel-2"
      >
        <h2 class="text-xl font-semibold text-fg">
          Normalización
        </h2>

        <p class="mt-3 text-sm leading-relaxed text-fg-2">
          Evidencias de normalización y diseño de bases de datos.
        </p>

        <p class="mt-5 text-sm font-medium text-fg">
          Ver evidencias →
        </p>
      </a>


      <!-- SQL -->
      <a
        href="/evidencias/sql/"
        class="rounded-2xl border border-line bg-panel p-7 transition-colors hover:bg-panel-2"
      >
        <h2 class="text-xl font-semibold text-fg">
          SQL
        </h2>

        <p class="mt-3 text-sm leading-relaxed text-fg-2">
          Consultas, ejercicios y actividades desarrolladas
          utilizando SQL.
        </p>

        <p class="mt-5 text-sm font-medium text-fg">
          Ver evidencias →
        </p>
      </a>


      <!-- PROYECTO -->
      <a
        href="/evidencias/proyecto/"
        class="rounded-2xl border border-line bg-panel p-7 transition-colors hover:bg-panel-2"
      >
        <h2 class="text-xl font-semibold text-fg">
          Proyecto
        </h2>

        <p class="mt-3 text-sm leading-relaxed text-fg-2">
          Proyecto final y evidencias relacionadas con el desarrollo
          de la asignatura.
        </p>

        <p class="mt-5 text-sm font-medium text-fg">
          Ver evidencias →
        </p>
      </a>

    </section>

  </Container>

</BaseLayout>
```
