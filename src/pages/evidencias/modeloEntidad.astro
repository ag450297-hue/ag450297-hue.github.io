---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
---

<BaseLayout title="Modelo Entidad Relación MER - Evidencias">

  <Container class="py-16 sm:py-24">

    <!-- ENCABEZADO -->
    <div class="mb-12 max-w-3xl">

      <div class="inline-flex items-center gap-2 rounded-full border border-violet-500/30 bg-violet-500/10 px-4 py-2 text-sm text-violet-300">
        <span class="h-2 w-2 rounded-full bg-violet-400"></span>
        Evidencias académicas
      </div>

      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white sm:text-5xl">
        Modelado
      </h1>

      <p class="mt-4 text-lg leading-8 text-slate-400">
        El equipo organizador de la University Champions League de la Universidad El Bosque, requiere un sistema de información que almacene las estadísticas del torneo de fútbol que se llevará a cabo en el mes de Abril. Por consiguiente, la información que se requiere consultar está relacionada a los equipos de fútbol, los semestres, los programas académicos al que pertenece, información de cada jugador, puntos obtenidos en cada juego, tarjetas amarillas/rojas por cada jugador y las posiciones de la tabla en tiempo real..
      </p>

    </div>


    <!-- EJERCICIOS -->

    <div id="ejemplos">

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">


        <!-- EJERCICIO 1 -->

        <article class="group overflow-hidden rounded-2xl border border-violet-500/20 bg-slate-950 shadow-xl shadow-violet-950/20 transition-all duration-300 hover:-translate-y-2 hover:border-violet-500/60">

          <div class="relative aspect-video overflow-hidden bg-slate-900">

            <img
              src="/images/UEB.png"
              alt="Ejercicio 1"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />

            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>

            <div class="absolute left-4 top-4 flex h-11 w-11 items-center justify-center rounded-xl border border-violet-400/30 bg-black/60 text-sm font-bold text-violet-300 backdrop-blur-md">
              01
            </div>

          </div>

          <div class="p-6">

            <p class="text-xs font-semibold uppercase tracking-widest text-violet-400">
              Ejercicio 01
            </p>

            <h2 class="mt-2 text-xl font-semibold text-white">
              Modelado básico
            </h2>

            <!-- ENUNCIADO COMO IMAGEN -->
            <div class="mt-4 overflow-hidden rounded-xl border border-violet-500/20 bg-slate-900">
              <img
                src="/images/ENUNCIADO-1.PNG"
                alt="Enunciado de la Evidencia 1"
                class="w-full object-contain"
              />
            </div>

            <button
              type="button"
              data-ejercicio="1"
              class="mt-6 inline-flex items-center gap-2 rounded-xl border border-violet-500/30 bg-violet-500/10 px-5 py-2.5 text-sm font-medium text-violet-300 transition-all duration-300 hover:bg-violet-500 hover:text-white"
            >
              Ver ejercicio
              <span class="text-lg">→</span>
            </button>

          </div>

        </article>


        <!-- EJERCICIO 2 -->

        <article class="group overflow-hidden rounded-2xl border border-blue-500/20 bg-slate-950 shadow-xl shadow-blue-950/20 transition-all duration-300 hover:-translate-y-2 hover:border-blue-500/60">

          <div class="relative aspect-video overflow-hidden bg-slate-900">

            <img
              src="/images/modelado/ejercicio-2.jpg"
              alt="Ejercicio 2"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />

            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>

            <div class="absolute left-4 top-4 flex h-11 w-11 items-center justify-center rounded-xl border border-blue-400/30 bg-black/60 text-sm font-bold text-blue-300 backdrop-blur-md">
              02
            </div>

          </div>

          <div class="p-6">

            <p class="text-xs font-semibold uppercase tracking-widest text-blue-400">
              Ejercicio 02
            </p>

            <h2 class="mt-2 text-xl font-semibold text-white">
              Modelado intermedio
            </h2>

            <p class="mt-3 text-sm leading-6 text-slate-400">
              Descripción del segundo ejercicio de modelado.
            </p>

            <button
              type="button"
              data-ejercicio="2"
              class="mt-6 inline-flex items-center gap-2 rounded-xl border border-blue-500/30 bg-blue-500/10 px-5 py-2.5 text-sm font-medium text-blue-300 transition-all duration-300 hover:bg-blue-500 hover:text-white"
            >
              Ver ejercicio
              <span class="text-lg">→</span>
            </button>

          </div>

        </article>


        <!-- EJERCICIO 3 -->

        <article class="group overflow-hidden rounded-2xl border border-violet-500/20 bg-slate-950 shadow-xl shadow-violet-950/20 transition-all duration-300 hover:-translate-y-2 hover:border-violet-500/60">

          <div class="relative aspect-video overflow-hidden bg-slate-900">

            <img
              src="/images/modelado/ejercicio-3.jpg"
              alt="Ejercicio 3"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />

            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>

            <div class="absolute left-4 top-4 flex h-11 w-11 items-center justify-center rounded-xl border border-violet-400/30 bg-black/60 text-sm font-bold text-violet-300 backdrop-blur-md">
              03
            </div>

          </div>

          <div class="p-6">

            <p class="text-xs font-semibold uppercase tracking-widest text-violet-400">
              Ejercicio 03
            </p>

            <h2 class="mt-2 text-xl font-semibold text-white">
              Proyecto final
            </h2>

            <p class="mt-3 text-sm leading-6 text-slate-400">
              Descripción del tercer ejercicio de modelado.
            </p>

            <button
              type="button"
              data-ejercicio="3"
              class="mt-6 inline-flex items-center gap-2 rounded-xl border border-violet-500/30 bg-violet-500/10 px-5 py-2.5 text-sm font-medium text-violet-300 transition-all duration-300 hover:bg-violet-500 hover:text-white"
            >
              Ver ejercicio
              <span class="text-lg">→</span>
            </button>

          </div>

        </article>

      </div>

    </div>


    <!-- DETALLE -->

    <section id="detalle" class="hidden mt-12">

      <button
        id="volver"
        type="button"
        class="mb-8 inline-flex items-center gap-2 rounded-xl border border-violet-500/30 bg-violet-500/10 px-5 py-2.5 text-sm font-medium text-violet-300 transition-all duration-300 hover:bg-violet-500 hover:text-white"
      >
        ← Volver a ejemplos
      </button>


      <div class="max-w-3xl">

        <p
          id="detalle-numero"
          class="text-xs font-semibold uppercase tracking-widest text-violet-400"
        >
          Ejercicio 01
        </p>

        <h2
          id="detalle-titulo"
          class="mt-3 text-4xl font-semibold tracking-tight text-white sm:text-5xl"
        >
          Modelado básico
        </h2>

        <p
          id="detalle-descripcion"
          class="mt-5 text-lg leading-8 text-slate-400"
        >
          Descripción del ejercicio.
        </p>

      </div>


      <!-- IMAGEN DEL EJERCICIO -->

      <div class="mt-10 overflow-hidden rounded-2xl border border-violet-500/20 bg-slate-950 shadow-2xl">

        <img
          id="detalle-imagen"
          src="/images/UEB.png"
          alt="Ejercicio de modelado"
          class="max-h-[700px] w-full object-contain"
        />

      </div>


      <!-- LINK -->

      <div class="mt-8 rounded-2xl border border-violet-500/20 bg-slate-950 p-6 sm:p-8">

        <h3 class="text-xl font-semibold text-white">
          Enlace del ejercicio
        </h3>

        <p class="mt-2 text-sm leading-6 text-slate-400">
          Puedes acceder al trabajo completo utilizando el siguiente enlace.
        </p>

        <a
          id="detalle-link"
          href="https://drive.google.com/file/d/1Jq8g0YcMh3SwBMEjL5vtbea3WKlNoUPp/view?usp=sharing"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 rounded-xl bg-violet-500 px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:bg-violet-400"
        >
          Abrir ejercicio
          <span class="text-lg">→</span>
        </a>

      </div>

    </section>

  </Container>


  <!-- JAVASCRIPT -->

  <script>
    const ejercicios = {
      1: {
        numero: 'Ejercicio 01',
        titulo: 'Modelado básico',
        descripcion: 'Enunciado y desarrollo del primer ejercicio de modelado.',
        imagen: '/images/UEB.png',
        link: 'https://drive.google.com/file/d/1Jq8g0YcMh3SwBMEjL5vtbea3WKlNoUPp/view?usp=sharing'
      },

      2: {
        numero: 'Ejercicio 02',
        titulo: 'Modelado intermedio',
        descripcion: 'Descripción del segundo ejercicio de modelado.',
        imagen: '/images/modelado/ejercicio-2.jpg',
        link: 'https://TU-LINK-2.com'
      },

      3: {
        numero: 'Ejercicio 03',
        titulo: 'Proyecto final',
        descripcion: 'Descripción del tercer ejercicio de modelado.',
        imagen: '/images/modelado/ejercicio-3.jpg',
        link: 'https://TU-LINK-3.com'
      }
    };

    const ejemplos = document.querySelector('#ejemplos');
    const detalle = document.querySelector('#detalle');
    const volver = document.querySelector('#volver');

    const detalleNumero = document.querySelector('#detalle-numero');
    const detalleTitulo = document.querySelector('#detalle-titulo');
    const detalleDescripcion = document.querySelector('#detalle-descripcion');
    const detalleImagen = document.querySelector('#detalle-imagen');
    const detalleLink = document.querySelector('#detalle-link');

    const botones = document.querySelectorAll('[data-ejercicio]');

    botones.forEach((boton) => {

      boton.addEventListener('click', () => {

        const id = boton.getAttribute('data-ejercicio');
        const ejercicio = ejercicios[id];

        if (!ejercicio) {
          return;
        }

        detalleNumero.textContent = ejercicio.numero;
        detalleTitulo.textContent = ejercicio.titulo;
        detalleDescripcion.textContent = ejercicio.descripcion;

        detalleImagen.src = ejercicio.imagen;
        detalleImagen.alt = ejercicio.titulo;

        detalleLink.href = ejercicio.link;

        ejemplos.classList.add('hidden');
        detalle.classList.remove('hidden');

        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });

      });

    });

    volver.addEventListener('click', () => {

      detalle.classList.add('hidden');
      ejemplos.classList.remove('hidden');

      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });

    });
  </script>

</BaseLayout>