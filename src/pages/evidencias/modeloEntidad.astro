---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';

const GOOGLE_DRIVE_QUIZ_LINK = "https://drive.google.com/file/d/1_nnPCp0OEzGMTzPdzsUqTnFbdDqKvXbN/view?usp=sharing";
---

<BaseLayout title="Evidencias y Quiz 1 - Modelo Entidad-Relación">
  <Container class="py-16 sm:py-24">

    <!-- ENCABEZADO PRINCIPAL -->
    <div class="mb-12 max-w-4xl">
      <div class="inline-flex items-center gap-2 rounded-full border border-violet-500/30 bg-violet-500/10 px-4 py-2 text-sm text-violet-300">
        <span class="h-2 w-2 rounded-full bg-violet-400"></span>
        Evidencias académicas
      </div>

      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white sm:text-5xl">
        Modelo Entidad-Relación (MER)
      </h1>

      <p class="mt-4 text-lg leading-8 text-slate-400">
        Recopilación de ejercicios prácticos y evidencias correspondientes al Quiz 1 y talleres de modelado conceptual.
      </p>
    </div>

    <!-- VISTA DE GALERÍA DE EJERCICIOS -->
    <div id="ejemplos">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">

        <!-- EJERCICIO 1: MODELADO BÁSICO -->
        <article class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-violet-500/20 bg-slate-950 shadow-xl shadow-violet-950/20 transition-all duration-300 hover:-translate-y-2 hover:border-violet-500/60">
          <div>
            <div class="relative aspect-video overflow-hidden bg-slate-900">
              <img src="/images/UEB.png" alt="Ejercicio 1" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
              <div class="absolute left-4 top-4 flex h-11 w-11 items-center justify-center rounded-xl border border-violet-400/30 bg-black/60 text-sm font-bold text-violet-300 backdrop-blur-md">01</div>
            </div>
            <div class="p-6">
              <p class="text-xs font-semibold uppercase tracking-widest text-violet-400">Taller · Ejercicio 01</p>
              <h2 class="mt-2 text-xl font-semibold text-white">Modelado básico</h2>
              <div class="mt-4 overflow-hidden rounded-xl border border-violet-500/20 bg-slate-900 p-4">
                <p class="text-sm leading-6 text-slate-300">
                  Sistema de información para la University Champions League (Universidad El Bosque). Registro de equipos, estadísticas, tarjetas y posiciones.
                </p>
              </div>
            </div>
          </div>
          <div class="flex flex-col gap-3 p-6 pt-0 sm:flex-row">
            <button type="button" data-ejercicio="1" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-violet-500/30 bg-violet-500/10 px-4 py-2.5 text-sm font-medium text-violet-300 transition-all duration-300 hover:bg-violet-500 hover:text-white">
              Ver detalle <span class="text-lg">→</span>
            </button>
            <a href="https://drive.google.com/file/d/1Jq8g0YcMh3SwBMEjL5vtbea3WKlNoUPp/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-violet-600/80 px-4 py-2.5 text-sm font-medium text-white transition-all duration-300 hover:bg-violet-500">
              Abrir Drive
            </a>
          </div>
        </article>

        <!-- QUIZ 1 - EJERCICIO 01 (EJERCICIO 2) -->
        <article class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-violet-500/20 bg-slate-950 shadow-xl shadow-violet-950/20 transition-all duration-300 hover:-translate-y-2 hover:border-violet-500/60">
          <div>
            <div class="relative aspect-video overflow-hidden bg-slate-900">
              <img src="/images/quiz1/Quiz-%231-MER-EJERCICIO-1.jpg" alt="Quiz 1 - Ejercicio 1" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
              <div class="absolute left-4 top-4 flex h-11 w-11 items-center justify-center rounded-xl border border-violet-400/30 bg-black/60 text-sm font-bold text-violet-300 backdrop-blur-md">02</div>
            </div>
            <div class="p-6">
              <p class="text-xs font-semibold uppercase tracking-widest text-violet-400">Quiz 1 · Ejercicio 01</p>
              <h2 class="mt-2 text-xl font-semibold text-white">Interpretación y corrección</h2>
              <div class="mt-4 overflow-hidden rounded-xl border border-violet-500/20 bg-slate-900 p-4">
                <p class="text-sm leading-6 text-slate-300">
                  Identificación y corrección de 4 errores conceptuales en el modelo entregado a una clínica veterinaria.
                </p>
              </div>
            </div>
          </div>
          <div class="flex flex-col gap-3 p-6 pt-0 sm:flex-row">
            <button type="button" data-ejercicio="2" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-violet-500/30 bg-violet-500/10 px-4 py-2.5 text-sm font-medium text-violet-300 transition-all duration-300 hover:bg-violet-500 hover:text-white">
              Ver detalle <span class="text-lg">→</span>
            </button>
            <a href={GOOGLE_DRIVE_QUIZ_LINK} target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-violet-600/80 px-4 py-2.5 text-sm font-medium text-white transition-all duration-300 hover:bg-violet-500">
              Abrir Drive
            </a>
          </div>
        </article>

        <!-- QUIZ 1 - EJERCICIO 02 (EJERCICIO 3) -->
        <article class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-blue-500/20 bg-slate-950 shadow-xl shadow-blue-950/20 transition-all duration-300 hover:-translate-y-2 hover:border-blue-500/60">
          <div>
            <div class="relative aspect-video overflow-hidden bg-slate-900">
              <img src="/images/quiz1/Quiz-%231-MER-EJERCICIO-2.jpg" alt="Quiz 1 - Ejercicio 2" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
              <div class="absolute left-4 top-4 flex h-11 w-11 items-center justify-center rounded-xl border border-blue-400/30 bg-black/60 text-sm font-bold text-blue-300 backdrop-blur-md">03</div>
            </div>
            <div class="p-6">
              <p class="text-xs font-semibold uppercase tracking-widest text-blue-400">Quiz 1 · Ejercicio 02</p>
              <h2 class="mt-2 text-xl font-semibold text-white">Diseño modelo biblioteca</h2>
              <div class="mt-4 overflow-hidden rounded-xl border border-blue-500/20 bg-slate-900 p-4">
                <p class="text-sm leading-6 text-slate-300">
                  Modelo conceptual para la biblioteca universitaria: títulos, ejemplares, préstamos, entidades débiles y relaciones recursivas.
                </p>
              </div>
            </div>
          </div>
          <div class="flex flex-col gap-3 p-6 pt-0 sm:flex-row">
            <button type="button" data-ejercicio="3" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-blue-500/30 bg-blue-500/10 px-4 py-2.5 text-sm font-medium text-blue-300 transition-all duration-300 hover:bg-blue-500 hover:text-white">
              Ver detalle <span class="text-lg">→</span>
            </button>
            <a href={GOOGLE_DRIVE_QUIZ_LINK} target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-blue-600/80 px-4 py-2.5 text-sm font-medium text-white transition-all duration-300 hover:bg-blue-500">
              Abrir Drive
            </a>
          </div>
        </article>

        <!-- QUIZ 1 - EJERCICIO 3 PARTE 1 (EJERCICIO 4) -->
        <article class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-violet-500/20 bg-slate-950 shadow-xl shadow-violet-950/20 transition-all duration-300 hover:-translate-y-2 hover:border-violet-500/60">
          <div>
            <div class="relative aspect-video overflow-hidden bg-slate-900">
              <img src="/images/quiz1/Quiz-%231-MER-Punto3,p1.jpg" alt="Quiz 1 - Punto 3 Parte 1" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
              <div class="absolute left-4 top-4 flex h-11 w-11 items-center justify-center rounded-xl border border-violet-400/30 bg-black/60 text-sm font-bold text-violet-300 backdrop-blur-md">04</div>
            </div>
            <div class="p-6">
              <p class="text-xs font-semibold uppercase tracking-widest text-violet-400">Quiz 1 · Punto 3 (P1)</p>
              <h2 class="mt-2 text-xl font-semibold text-white">Relación ternaria</h2>
              <div class="mt-4 overflow-hidden rounded-xl border border-violet-500/20 bg-slate-900 p-4">
                <p class="text-sm leading-6 text-slate-300">
                  Análisis y representación del registro de atención de médicos, pacientes y consultorios en un hospital.
                </p>
              </div>
            </div>
          </div>
          <div class="flex flex-col gap-3 p-6 pt-0 sm:flex-row">
            <button type="button" data-ejercicio="4" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-violet-500/30 bg-violet-500/10 px-4 py-2.5 text-sm font-medium text-violet-300 transition-all duration-300 hover:bg-violet-500 hover:text-white">
              Ver detalle <span class="text-lg">→</span>
            </button>
            <a href={GOOGLE_DRIVE_QUIZ_LINK} target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-violet-600/80 px-4 py-2.5 text-sm font-medium text-white transition-all duration-300 hover:bg-violet-500">
              Abrir Drive
            </a>
          </div>
        </article>

        <!-- QUIZ 1 - EJERCICIO 3 PARTE 2 (EJERCICIO 5) -->
        <article class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-blue-500/20 bg-slate-950 shadow-xl shadow-blue-950/20 transition-all duration-300 hover:-translate-y-2 hover:border-blue-500/60">
          <div>
            <div class="relative aspect-video overflow-hidden bg-slate-900">
              <img src="/images/quiz1/Quiz-%231-MER-EJERCICIO-3%20(P2).jpg" alt="Quiz 1 - Punto 3 Parte 2" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
              <div class="absolute left-4 top-4 flex h-11 w-11 items-center justify-center rounded-xl border border-blue-400/30 bg-black/60 text-sm font-bold text-blue-300 backdrop-blur-md">05</div>
            </div>
            <div class="p-6">
              <p class="text-xs font-semibold uppercase tracking-widest text-blue-400">Quiz 1 · Punto 3 (P2)</p>
              <h2 class="mt-2 text-xl font-semibold text-white">Especialización</h2>
              <div class="mt-4 overflow-hidden rounded-xl border border-blue-500/20 bg-slate-900 p-4">
                <p class="text-sm leading-6 text-slate-300">
                  Representación de jerarquía entre Usuarios (Estudiantes y Docentes) especificando disyunción y totalidad.
                </p>
              </div>
            </div>
          </div>
          <div class="flex flex-col gap-3 p-6 pt-0 sm:flex-row">
            <button type="button" data-ejercicio="5" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-blue-500/30 bg-blue-500/10 px-4 py-2.5 text-sm font-medium text-blue-300 transition-all duration-300 hover:bg-blue-500 hover:text-white">
              Ver detalle <span class="text-lg">→</span>
            </button>
            <a href={GOOGLE_DRIVE_QUIZ_LINK} target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-blue-600/80 px-4 py-2.5 text-sm font-medium text-white transition-all duration-300 hover:bg-blue-500">
              Abrir Drive
            </a>
          </div>
        </article>

        <!-- QUIZ 1 - EJERCICIO 3 PARTE 3 (EJERCICIO 6) -->
        <article class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-violet-500/20 bg-slate-950 shadow-xl shadow-violet-950/20 transition-all duration-300 hover:-translate-y-2 hover:border-violet-500/60">
          <div>
            <div class="relative aspect-video overflow-hidden bg-slate-900">
              <img src="/images/quiz1/Quiz-%231-MER-EJERCICIO-3%20(P3).jpg" alt="Quiz 1 - Punto 3 Parte 3" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
              <div class="absolute left-4 top-4 flex h-11 w-11 items-center justify-center rounded-xl border border-violet-400/30 bg-black/60 text-sm font-bold text-violet-300 backdrop-blur-md">06</div>
            </div>
            <div class="p-6">
              <p class="text-xs font-semibold uppercase tracking-widest text-violet-400">Quiz 1 · Punto 3 (P3)</p>
              <h2 class="mt-2 text-xl font-semibold text-white">Agregación</h2>
              <div class="mt-4 overflow-hidden rounded-xl border border-violet-500/20 bg-slate-900 p-4">
                <p class="text-sm leading-6 text-slate-300">
                  Asignación de equipos de laboratorio en proyectos mediante abstracción de agregación.
                </p>
              </div>
            </div>
          </div>
          <div class="flex flex-col gap-3 p-6 pt-0 sm:flex-row">
            <button type="button" data-ejercicio="6" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-violet-500/30 bg-violet-500/10 px-4 py-2.5 text-sm font-medium text-violet-300 transition-all duration-300 hover:bg-violet-500 hover:text-white">
              Ver detalle <span class="text-lg">→</span>
            </button>
            <a href={GOOGLE_DRIVE_QUIZ_LINK} target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-violet-600/80 px-4 py-2.5 text-sm font-medium text-white transition-all duration-300 hover:bg-violet-500">
              Abrir Drive
            </a>
          </div>
        </article>

      </div>
    </div>

    <!-- VISTA DE DETALLE -->
    <section id="detalle" class="mt-12 hidden">
      <button id="volver" type="button" class="mb-8 inline-flex items-center gap-2 rounded-xl border border-violet-500/30 bg-violet-500/10 px-5 py-2.5 text-sm font-medium text-violet-300 transition-all duration-300 hover:bg-violet-500 hover:text-white">
        ← Volver a evidencias
      </button>

      <div class="max-w-4xl">
        <p id="detalle-numero" class="text-xs font-semibold uppercase tracking-widest text-violet-400">
          Ejercicio 01
        </p>

        <h2 id="detalle-titulo" class="mt-3 text-4xl font-semibold tracking-tight text-white sm:text-5xl">
          Título del Ejercicio
        </h2>

        <div class="mt-6 rounded-2xl border border-violet-500/20 bg-slate-950 p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-violet-400">Enunciado / Descripción</p>
          <p id="detalle-descripcion" class="mt-4 text-lg leading-8 text-slate-400">
            Descripción detallada...
          </p>
        </div>
      </div>

      <!-- VISUALIZACIÓN DE IMAGEN PRINCIPAL -->
      <div class="mt-10 overflow-hidden rounded-2xl border border-violet-500/20 bg-slate-950 shadow-2xl">
        <img id="detalle-imagen" src="" alt="Evidencia" class="max-h-[900px] w-full object-contain" />
      </div>

      <!-- SECCIÓN DE RECURSO ADICIONAL -->
      <div id="detalle-link-container" class="mt-8 rounded-2xl border border-violet-500/20 bg-slate-950 p-6 sm:p-8">
        <h3 class="text-xl font-semibold text-white">Enlace o soporte del ejercicio</h3>
        <p class="mt-2 text-sm leading-6 text-slate-400">Puedes consultar el documento original en Google Drive mediante el siguiente enlace.</p>
        <a id="detalle-link" href="#" target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-violet-500 px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:bg-violet-400">
          Abrir recurso en Google Drive <span class="text-lg">→</span>
        </a>
      </div>
    </section>

  </Container>

  <!-- SCRIPT DE INTERACCIÓN Y MAPEO DE DATOS -->
  <script>
    const DRIVE_LINK_GENERAL = 'https://drive.google.com/file/d/1_nnPCp0OEzGMTzPdzsUqTnFbdDqKvXbN/view?usp=sharing';

    const ejercicios = {
      1: {
        numero: 'Taller · Ejercicio 01',
        titulo: 'Modelado básico (University Champions League)',
        descripcion: 'El equipo organizador de la University Champions League de la Universidad El Bosque requiere un sistema para almacenar estadísticas del torneo de fútbol: equipos, semestres, programas académicos, jugadores, puntos, tarjetas amarillas/rojas y tabla de posiciones.',
        imagen: '/images/UEB.png',
        link: 'https://drive.google.com/file/d/1Jq8g0YcMh3SwBMEjL5vtbea3WKlNoUPp/view?usp=sharing'
      },
      2: {
        numero: 'Quiz 1 · Ejercicio 01',
        titulo: 'Interpretación y corrección de un modelo',
        descripcion: 'Una clínica veterinaria contrató a un estudiante para modelar su base de datos relacional (entidades DUEÑO, MASCOTA y VETERINARIO). Se identificaron y corrigieron 4 errores de reglas de negocio para generar el esquema conceptual correcto.',
        imagen: '/images/quiz1/Quiz-%231-MER-EJERCICIO-1.jpg',
        link: DRIVE_LINK_GENERAL
      },
      3: {
        numero: 'Quiz 1 · Ejercicio 02',
        titulo: 'Diseño de un modelo entidad-relación',
        descripcion: 'Modelo conceptual completo para la biblioteca de la Universidad: registro de títulos, autores, ejemplares físicos, usuarios y préstamos. Incluye atributos clave, compuestos, multivaluados, derivados, entidad débil y relación recursiva.',
        imagen: '/images/quiz1/Quiz-%231-MER-EJERCICIO-2.jpg',
        link: DRIVE_LINK_GENERAL
      },
      4: {
        numero: 'Quiz 1 · Punto 3 · Parte 1',
        titulo: 'Relación ternaria',
        descripcion: 'Modelo para el registro de atención en un hospital entre MÉDICO, PACIENTE y CONSULTORIO en una fecha determinada. Justificación del uso y equivalencia de una relación ternaria sobre relaciones binarias.',
        imagen: '/images/quiz1/Quiz-%231-MER-Punto3,p1.jpg',
        link: DRIVE_LINK_GENERAL
      },
      5: {
        numero: 'Quiz 1 · Punto 3 · Parte 2',
        titulo: 'Especialización',
        descripcion: 'Representación de la jerarquía de USUARIOS en la biblioteca (disyunción total entre ESTUDIANTE y DOCENTE), registrando atributos específicos como semestre o facultad.',
        imagen: '/images/quiz1/Quiz-%231-MER-EJERCICIO-3%20(P2).jpg',
        link: DRIVE_LINK_GENERAL
      },
      6: {
        numero: 'Quiz 1 · Punto 3 · Parte 3',
        titulo: 'Agregación',
        descripcion: 'Representación mediante agregación de la asignación de EQUIPOS de laboratorio a un DOCENTE según su participación en un PROYECTO específico mediante la relación TRABAJA_EN.',
        imagen: '/images/quiz1/Quiz-%231-MER-EJERCICIO-3%20(P3).jpg',
        link: DRIVE_LINK_GENERAL
      }
    };

    const ejemplos = document.querySelector('#ejemplos');
    const detalle = document.querySelector('#detalle');
    const volver = document.querySelector('#volver');

    const detalleNumero = document.querySelector('#detalle-numero');
    const detalleTitulo = document.querySelector('#detalle-titulo');
    const detalleDescripcion = document.querySelector('#detalle-descripcion');
    const detalleImagen = document.querySelector('#detalle-imagen');
    const detalleLinkContainer = document.querySelector('#detalle-link-container');
    const detalleLink = document.querySelector('#detalle-link');

    const botones = document.querySelectorAll('[data-ejercicio]');

    botones.forEach((boton) => {
      boton.addEventListener('click', () => {
        const id = boton.getAttribute('data-ejercicio');
        const ejercicio = ejercicios[id];

        if (!ejercicio) return;

        detalleNumero.textContent = ejercicio.numero;
        detalleTitulo.textContent = ejercicio.titulo;
        detalleDescripcion.textContent = ejercicio.descripcion;
        detalleImagen.src = ejercicio.imagen;
        detalleImagen.alt = ejercicio.titulo;

        if (ejercicio.link) {
          detalleLink.href = ejercicio.link;
          detalleLinkContainer.classList.remove('hidden');
        } else {
          detalleLinkContainer.classList.add('hidden');
        }

        ejemplos.classList.add('hidden');
        detalle.classList.remove('hidden');

        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });

    volver.addEventListener('click', () => {
      detalle.classList.add('hidden');
      ejemplos.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  </script>
</BaseLayout>