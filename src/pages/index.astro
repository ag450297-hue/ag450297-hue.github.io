---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
---

<BaseLayout
  title="[Angelica Gomez] — Portafolio"
  description="Portafolio académico de [Angelica Gomez], estudiante de Ingeniería de Sistemas."
>

  <Container class="py-16 sm:py-24">

    <!-- PRESENTACIÓN -->
    <section class="mx-auto max-w-4xl text-center">

      <p class="font-mono text-sm uppercase tracking-widest text-fg-3">
        Portafolio académico
      </p>

      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-fg sm:text-6xl">
        Hola, soy
        <span class="text-gradient">[Angelica Gomez]</span>
      </h1>

      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-fg-2">
        Estudiante de Ingeniería de Sistemas en la Universidad El Bosque.
      </p>

      <!-- FOTO -->
      <div class="mt-10 flex justify-center">
        <img
          src="/images/perfil.jpg"
          alt="Foto de [Angelica Gomez]"
          class="h-52 w-52 rounded-full object-cover shadow-xl"
        />
      </div>

      <!-- SOBRE MÍ -->
      <div class="mx-auto mt-10 max-w-2xl">

        <h2 class="text-2xl font-semibold text-fg">
          Sobre mí
        </h2>

        <p class="mt-4 text-lg leading-relaxed text-fg-2">
          [Estudiante de Ingeniería de Sistemas, caracterizada por la responsabilidad, el compromiso y la honestidad.
           Me adapto fácilmente al trabajo en equipo y mantengo un buen nivel de eficiencia en el cumplimiento de mis funciones.]
        </p>

      </div>

    </section>


    <!-- FORMACIÓN -->
    <section class="mx-auto mt-16 max-w-4xl">

      <div class="rounded-2xl border border-line bg-panel p-8 text-center">

        <p class="font-mono text-sm uppercase tracking-widest text-fg-3">
          Formación académica
        </p>

        <h2 class="mt-4 text-2xl font-semibold text-fg">
          Ingeniería de Sistemas
        </h2>

        <p class="mt-2 text-fg-2">
          Universidad El Bosque
        </p>

        <p class="mt-4 text-sm text-fg-3">
          Asignatura: Bases de Datos 1
        </p>

      </div>

    </section>


    <!-- VIDEO -->
    <section class="mx-auto mt-16 max-w-4xl">

      <div class="text-center">

        <p class="font-mono text-sm uppercase tracking-widest text-fg-3">
          Presentación
        </p>

        <h2 class="mt-3 text-3xl font-semibold text-fg">
          Video de presentación
        </h2>

<p class="mx-auto mt-4 max-w-2xl leading-relaxed text-fg-2">
  A continuación te comparto mi video de presentación.
</p>

</div>

<!-- REPRODUCTOR DE VIDEO EMBEBIDO DE YOUTUBE -->
<div class="mt-8 overflow-hidden rounded-2xl border border-line bg-panel aspect-video shadow-lg">
  <iframe 
    class="w-full h-full"
    src="https://www.youtube.com/embed/vjsCe8hjdMs" 
    title="Video de presentación" 
    frameborder="0" 
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
    allowfullscreen>
  </iframe>
</div>

</section>

    <!-- EVIDENCIAS -->
    <section class="mx-auto mt-16 max-w-4xl text-center">

      <h2 class="text-2xl font-semibold text-fg">
        Evidencias académicas
      </h2>

      <p class="mx-auto mt-3 max-w-xl text-fg-2">
        Consulta las actividades y trabajos desarrollados
        durante el semestre en Bases de Datos 1.
      </p>

      <a
        href="/evidencias/"
        class="mt-6 inline-flex rounded-lg bg-brand px-6 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
      >
        Ver evidencias →
      </a>

    </section>

  </Container>

</BaseLayout>