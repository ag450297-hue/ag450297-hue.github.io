---
import { Code } from 'astro:components';
import codeTheme from '@shikijs/themes/catppuccin-mocha';
import Button from '../Button.astro';
import WindowDots from '../WindowDots.astro';
import Container from '../Container.astro';
import Glow from '../Glow.astro';

// Cambiamos el código de ejemplo por una consulta SQL real de Bases de Datos
const heroCode = `-- Consulta de ejemplo: Listar evidencias del semestre
SELECT 
  id_evidencia, 
  titulo_modulo, 
  fecha_entrega, 
  estado 
FROM 
  evidencias_academicas
WHERE 
  asignatura = 'Bases de Datos 1'
ORDER BY 
  fecha_entrega ASC;`;
---

<section class="relative overflow-hidden">
  <Glow class="left-1/2 top-[-180px] h-[480px] w-[820px] -translate-x-1/2" />

  <!-- Faint grid backdrop -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 [background-image:linear-gradient(rgb(255_255_255/0.025)_1px,transparent_1px),linear-gradient(90deg,rgb(255_255_255/0.025)_1px,transparent_1px)] [background-size:56px_56px] [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_75%)]"
  >
  </div>

  <Container class="relative pb-24 pt-20 sm:pt-28">
    <div class="mx-auto max-w-3xl text-center">
      
      <!-- Enlace superior adaptado a tu entrega -->
      <a
        href="#presentacion-estudiante"
        class="glass inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-[13px] text-fg-2 transition-colors hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      >
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent shadow-[0_0_8px_rgb(34_211_238/0.8)]"></span>
        E-Portafolio Académico Oficial
        <span aria-hidden="true" class="text-fg-3">↓</span>
      </a>

      <!-- Título Principal adaptado -->
      <h1 class="mt-6 text-balance text-5xl font-semibold leading-[1.05] tracking-tight sm:text-6xl">
        Gestión de Evidencias <span class="text-gradient">Bases de Datos 1</span>
      </h1>

      <!-- Descripción adaptada -->
      <p class="mx-auto mt-6 max-w-xl text-pretty text-lg leading-relaxed text-fg-2">
        Espacio digital profesional diseñado para recopilar, organizar y publicar los talleres prácticos, 
        modelos relacionales y proyectos desarrollados durante el semestre académico.
      </p>

      <!-- Botones de Acción apuntando al Blog de Evidencias y a tu presentación -->
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <Button href="/blog/" size="lg">Ver Evidencias (Bonus)</Button>
        <Button href="#presentacion-estudiante" variant="secondary" size="lg">Ir a Presentación</Button>
      </div>

      <!-- Consola de comandos simulada con SQL -->
      <p class="mt-5 font-mono text-[13px] text-fg-2">
        <span class="select-none text-fg-3">$</span> psql -h localhost -U estudiante -d bases_datos_1
      </p>
    </div>

    <!-- Code panel - Panel de Código simulando un entorno de Base de Datos -->
    <div class="relative mx-auto mt-16 max-w-4xl">
      <div class="glass relative grid overflow-hidden rounded-xl shadow-2xl shadow-black/50 md:grid-cols-[1.5fr_1fr]">
        
        <!-- Editor pane (Editor SQL) -->
        <div class="min-w-0 border-b border-line md:border-b-0 md:border-r">
          <div class="flex items-center gap-2 border-b border-line px-4 py-3">
            <WindowDots />
            <span class="ml-3 font-mono text-xs text-fg-3">queries/consulta_evidencias.sql</span>
          </div>
          <div class="overflow-x-auto p-4 text-left">
            <Code code={heroCode} lang="sql" theme={codeTheme} />
          </div>
        </div>

        <!-- Terminal pane (Terminal de Base de Datos PostgreSQL) -->
        <div class="min-w-0 bg-ink-2/60">
          <div class="flex items-center border-b border-line px-4 py-3">
            <span class="font-mono text-xs text-fg-3">postgresql-terminal</span>
          </div>
          <div class="space-y-2 p-4 text-left font-mono text-[13px] leading-relaxed">
            <p class="text-fg-2"><span class="select-none text-fg-3">bases_datos_1=#</span> \i queries/consulta_evidencias.sql</p>
            <p class="text-fg-3">Ejecutando script en servidor local...</p>
            <p><span class="text-accent">✓</span> <span class="text-fg-2">Conexión exitosa a la BD</span></p>
            <p><span class="text-accent">✓</span> <span class="text-fg-2">(4 filas afectadas - Módulos listos)</span></p>
            <p class="pt-1 text-fg-2">
              <span class="text-brand-bright">→</span> Estado del Portafolio: 
              <span class="text-brand-bright">[CONFIGURADO]</span>
            </p>
            <p class="flex items-center gap-2 pt-2 text-fg-3">
              <span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-accent motion-reduce:animate-none"></span>
              servidor listo para recibir datos
            </p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
